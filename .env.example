# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/intellipolicy?retryWrites=true&w=majority

# Auth0
AUTH0_SECRET=your_auth0_secret_here
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# API
NEXT_PUBLIC_API_URL=http://localhost:3000/api
API_KEY_HEADER_NAME=X-API-Key
API_SECRET_HEADER_NAME=X-API-Secret

# IntelliDoc Integration
INTELLIDOC_API_URL=http://localhost:4000/api
INTELLIDOC_API_KEY=your_intellidoc_api_key
INTELLIDOC_API_SECRET=your_intellidoc_api_secret
INTELLIDOC_WEBHOOK_URL=http://localhost:3000/api/webhooks/intellidoc

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Environment
NODE_ENV=development
